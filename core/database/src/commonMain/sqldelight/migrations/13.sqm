CREATE TABLE UserShowsEntity (
  showId TEXT NOT NULL PRIMARY KEY,
  addedAt TEXT NOT NULL,
  updatedAt TEXT NOT NULL,
  status TEXT NOT NULL,
  notes TEXT,
  rating INTEGER
);

CREATE TABLE UserEpisodesEntity (
  episodeId INTEGER NOT NULL PRIMARY KEY,
  watchedAt TEXT
);

CREATE TABLE ShowDetailsEntity (
  id INTEGER NOT NULL PRIMARY KEY,
  totalEpisodes INTEGER NOT NULL,
  totalSeasons INTEGER NOT NULL
);

CREATE TABLE ShowSyncError (
  showId INTEGER NOT NULL,
  targetSeason INTEGER NOT NULL
);
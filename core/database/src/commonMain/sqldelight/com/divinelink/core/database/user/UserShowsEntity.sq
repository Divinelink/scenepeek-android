CREATE TABLE UserShowsEntity (
  showId INTEGER NOT NULL PRIMARY KEY,
  addedAt TEXT NOT NULL,
  updatedAt TEXT NOT NULL,
  status TEXT NOT NULL,
  notes TEXT,
  rating INTEGER
);

-- Fast library filtering
CREATE INDEX idx_user_shows_status ON UserShowsEntity(status);

-- Check if specific episode is watched (most frequent query)
CREATE UNIQUE INDEX idx_user_episode_unique
ON UserShowsEntity(showId);

insertUserShow:
INSERT OR REPLACE INTO UserShowsEntity (
  showId,
  addedAt,
  updatedAt,
  status,
  notes,
  rating
)
VALUES (?,?,?,?,?,?);

deleteUserShow:
DELETE FROM UserShowsEntity WHERE showId = :showId;

getUserShowStatus:
SELECT
  showId,
  status
FROM UserShowsEntity
WHERE showId = :showId;

getAllUserShows:
SELECT
  s.id AS showId,
  s.name,
  s.posterPath AS posterPath,
  us.status,
  us.addedAt,
  us.updatedAt
FROM MediaItemEntity s
JOIN UserShowsEntity us ON s.id = us.showId
LEFT JOIN EpisodeEntity e ON s.id = e.showId
LEFT JOIN UserEpisodesEntity ue ON e.id = ue.episodeId
GROUP BY s.id
ORDER BY us.updatedAt DESC;

nextUpEpisode:
SELECT
  e.id AS episodeId,
  e.seasonNumber AS seasonNumber,
  e.episodeNumber AS episodeNumber,
  e.name AS episodeName,
  e.stillPath AS thumbnailPath,
  e.airDate AS airDate
FROM EpisodeEntity e
LEFT JOIN UserEpisodesEntity ue ON e.id = ue.episodeId
WHERE e.showId = :showId
  AND e.airDate <= CURRENT_DATE -- Only show episodes that have actually aired
  AND ue.episodeId IS NULL -- Exclude episodes that are already watched
ORDER BY e.seasonNumber ASC, e.episodeNumber ASC
LIMIT 1;

getAllUpNextEpisodes:
SELECT
  show.id AS showId,
  show.name AS showTitle,
  show.posterPath AS showPosterPath,
  episode.id AS episodeId,
  episode.seasonNumber AS seasonNumber,
  episode.episodeNumber AS episodeNumber,
  episode.name AS episodeName,
  episode.stillPath AS episodeThumbnail,
  episode.airDate AS airDate
FROM MediaItemEntity show
JOIN UserShowsEntity userShow ON show.id = userShow.showId
JOIN EpisodeEntity episode ON episode.id = (
    SELECT episode2.id
    FROM EpisodeEntity episode2
    LEFT JOIN UserEpisodesEntity userEpisode ON episode2.id = userEpisode.episodeId
    WHERE episode2.showId = show.id
      AND episode2.airDate <= CURRENT_DATE
      AND userEpisode.episodeId IS NULL
    ORDER BY episode2.seasonNumber ASC, episode2.episodeNumber ASC
    LIMIT 1
)
WHERE userShow.status != 'completed' AND episode.seasonNumber != 0
ORDER BY userShow.updatedAt DESC;

-- Find the first season that is NOT fully watched
findFirstIncompleteSeason:
SELECT episode.seasonNumber AS seasonNumber
FROM EpisodeEntity episode
LEFT JOIN UserEpisodesEntity userEpisode ON episode.id = userEpisode.episodeId
WHERE episode.showId = :showId AND episode.seasonNumber > 0
GROUP BY episode.seasonNumber
HAVING COUNT(episode.id) > COUNT(userEpisode.episodeId) -- Total eps > Watched eps
ORDER BY episode.seasonNumber ASC
LIMIT 1;

-- Get total episodes in a specific season (to know how many to expect)
getEpisodeCountForSeason:
SELECT COUNT(*) AS count
FROM EpisodeEntity
WHERE showId = :showId AND seasonNumber = :seasonNumber;
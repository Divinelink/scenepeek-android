CREATE TABLE ShowEntity (
  id INTEGER NOT NULL PRIMARY KEY ,
  title TEXT NOT NULL,
  overview TEXT,
  posterPath TEXT,
  backdropPath TEXT,
  firstAirDate TEXT,
  status TEXT NOT NULL,
  voteAverage REAL NOT NULL,
  voteCount INTEGER NOT NULL,
  totalSeasons INTEGER NOT NULL,
  lastSyncedAt TEXT NOT NULL
);

insertShow:
INSERT OR REPLACE INTO ShowEntity (
  id,
  title,
  overview,
  posterPath,
  backdropPath,
  firstAirDate,
  status,
  voteAverage,
  voteCount,
  totalSeasons,
  lastSyncedAt
)
VALUES ?;

fetchShow:
SELECT * FROM ShowEntity
WHERE id = ?;

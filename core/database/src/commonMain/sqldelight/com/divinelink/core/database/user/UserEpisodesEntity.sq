CREATE TABLE UserEpisodesEntity (
  episodeId INTEGER NOT NULL PRIMARY KEY,
  watchedAt TEXT
);

upsertUserEpisode:
INSERT OR REPLACE INTO UserEpisodesEntity (
  episodeId,
  watchedAt
)
VALUES (?,?);

deleteUserEpisode:
DELETE FROM UserEpisodesEntity WHERE episodeId = ?;

CREATE INDEX idx_user_episodes_episode_id
ON UserEpisodesEntity(episodeId);

isWatchedEpisode:
SELECT COUNT(*) > 0 AS watched
FROM UserEpisodesEntity
WHERE episodeId = ?;

watchedCountForSeason:
SELECT COUNT(*) AS count
FROM UserEpisodesEntity ue
JOIN EpisodeEntity e ON ue.episodeId = e.id
WHERE e.showId = :showId
  AND e.seasonNumber = :seasonNumber;

seasonsProgress:
SELECT
  e.seasonNumber,
  COUNT(ue.episodeId) AS watchedCount
FROM EpisodeEntity e
LEFT JOIN UserEpisodesEntity ue
  ON e.id = ue.episodeId
WHERE e.showId = :showId
GROUP BY e.seasonNumber
ORDER BY e.seasonNumber;

getAllSeasonNumbers:
SELECT DISTINCT seasonNumber
FROM EpisodeEntity
WHERE showId = :showId;

watchedEpisodesForSeason:
SELECT
  e.id AS episodeId
FROM EpisodeEntity e
INNER JOIN UserEpisodesEntity ue ON e.id = ue.episodeId
WHERE e.showId = :showId
  AND e.seasonNumber = :seasonNumber;

watchedEpisodesForShow:
SELECT episodeId, watchedAt
FROM EpisodeEntity e
INNER JOIN UserEpisodesEntity ue ON e.id = ue.episodeId
WHERE e.showId = :showId;

getUserSeasonProgress:
SELECT
  COUNT(e.id) AS totalEpisodes,
  COUNT(ue.episodeId) AS watchedEpisodes
FROM EpisodeEntity e
LEFT JOIN UserEpisodesEntity ue ON e.id = ue.episodeId
WHERE e.showId = :showId
  AND e.seasonNumber = :seasonNumber;